{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Treemap of koala hospital admissions by local government area",
  "width": 520,
  "height": 380,
  "padding": 2,
  "autosize": "none",
  "config": {
    "font": "DM Sans"
  },
  "signals": [
    {
      "name": "hovered",
      "value": null,
      "on": [
        {
          "events": "rect:mouseover",
          "update": "datum.id"
        },
        {
          "events": "rect:mouseout",
          "update": "null"
        }
      ]
    }
  ],
  "data": [
    {
      "name": "tree",
      "url": "data/cleaned/lga_treemap.json",
      "transform": [
        {
          "type": "stratify",
          "key": "id",
          "parentKey": "parent"
        },
        {
          "type": "treemap",
          "field": "records",
          "sort": {
            "field": "value",
            "order": "descending"
          },
          "round": true,
          "method": "squarify",
          "ratio": 1.4,
          "size": [
            {
              "signal": "width"
            },
            {
              "signal": "height"
            }
          ]
        }
      ]
    },
    {
      "name": "leaves",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "!datum.children"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "color",
      "type": "sqrt",
      "domain": {
        "data": "leaves",
        "field": "records"
      },
      "range": {
        "scheme": "blues"
      },
      "zero": false
    }
  ],
  "marks": [
    {
      "type": "rect",
      "from": {
        "data": "leaves"
      },
      "encode": {
        "enter": {
          "strokeWidth": {
            "value": 2
          }
        },
        "update": {
          "x": {
            "field": "x0"
          },
          "y": {
            "field": "y0"
          },
          "x2": {
            "field": "x1"
          },
          "y2": {
            "field": "y1"
          },
          "fill": {
            "scale": "color",
            "field": "records"
          },
          "stroke": [
            {
              "test": "hovered === datum.id",
              "value": "#1e3028"
            },
            {
              "value": "white"
            }
          ],
          "tooltip": {
            "signal": "{'Area': datum.name, 'Koalas admitted': format(datum.records, ',.0f'), 'Share of all admissions': format(datum.records / 33294, '.1%')}"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "leaves"
      },
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "signal": "(datum.x0 + datum.x1) / 2"
          },
          "y": {
            "signal": "(datum.y0 + datum.y1) / 2"
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "DM Sans"
          },
          "fontSize": {
            "signal": "datum.records > 5000 ? 15 : 11"
          },
          "fontWeight": {
            "value": "bold"
          },
          "limit": {
            "signal": "datum.x1 - datum.x0 - 6"
          },
          "fill": {
            "signal": "datum.records > 1800 ? '#ffffff' : '#1e3028'"
          },
          "lineHeight": {
            "value": 13
          },
          "text": {
            "signal": "(datum.x1 - datum.x0) < 52 || (datum.y1 - datum.y0) < 28 ? '' : (datum.x1 - datum.x0) > 130 ? datum.name + ' · ' + format(datum.records, ',.0f') : [datum.name, format(datum.records, ',.0f')]"
          }
        }
      }
    }
  ]
}