            "lat": -35.28
          }
        ]
      },
      "mark": {
        "type": "circle",
        "size": 28,
        "color": "#1e3028"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        }
      }
    },
    {
