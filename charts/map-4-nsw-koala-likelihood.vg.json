{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "font": "DM Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "labelColor": "#44554b",
      "titleColor": "#44554b",
      "gridColor": "#edf1ed",
      "domainColor": "#9aa89f",
      "tickColor": "#9aa89f"
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 11,
      "labelColor": "#44554b",
      "titleColor": "#44554b"
    }
  },
  "width": "container",
  "height": 440,
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "data/cleaned/australia_states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.state == 'New South Wales'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#f4f6f1",
        "stroke": "#b9c6bc",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/cleaned/nsw_koala_likelihood_cells.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.sites_surveyed >= 5"
        }
      ],
      "mark": {
        "type": "geoshape",
        "strokeWidth": 0.6
      },
      "encoding": {
        "fill": {
          "field": "properties.likelihood_pct",
          "type": "quantitative",
          "scale": {
            "type": "threshold",
            "domain": [
              1,
              10,
              25,
              50,
              75
            ],
            "range": [
              "#EFF2F8",
              "#C8D5F2",
              "#92B4DE",
              "#60A5D4",
              "#1769AA",
              "#214F88"
            ]
          },
          "legend": {
            "title": "Surveyed sites with koalas (%)",
            "type": "symbol",
            "orient": "bottom-left",
            "direction": "horizontal",
            "symbolType": "square",
            "labelLimit": 120
          }
        },
        "stroke": {
          "field": "properties.likelihood_pct",
          "type": "quantitative",
          "scale": {
            "type": "threshold",
            "domain": [
              1,
              10,
              25,
              50,
              75
            ],
            "range": [
              "#EFF2F8",
              "#C8D5F2",
              "#92B4DE",
              "#60A5D4",
              "#1769AA",
              "#214F88"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "properties.likelihood_pct",
            "type": "quantitative",
            "title": "Sites with koalas (%)"
          },
          {
            "field": "properties.sites_with_koalas",
            "type": "quantitative",
            "title": "Sites with koalas"
          },
          {
            "field": "properties.sites_surveyed",
            "type": "quantitative",
            "title": "Sites surveyed"
          },
          {
            "field": "properties.confidence",
            "type": "nominal",
            "title": "Data confidence (A best)"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "n": "Sydney",
            "lon": 151.21,
            "lat": -33.87
          },
          {
            "n": "Newcastle",
            "lon": 151.78,
            "lat": -32.93
          },
          {
            "n": "Coffs Harbour",
