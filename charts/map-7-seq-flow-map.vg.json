{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "font": "DM Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "labelColor": "#44554b",
      "titleColor": "#44554b",
      "gridColor": "#edf1ed",
      "domainColor": "#9aa89f",
      "tickColor": "#9aa89f"
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 11,
      "labelColor": "#44554b",
      "titleColor": "#44554b"
    }
  },
  "width": "container",
  "height": 450,
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "data/cleaned/seq_basemap.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#eef2ea",
        "stroke": "#b9c6bc",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/cleaned/flow_map_sample.csv",
        "format": {
          "type": "csv",
          "parse": {
            "lat": "number",
            "lon": "number",
            "lat2": "number",
            "lon2": "number",
            "distance_km": "number",
            "year": "number"
          }
        }
      },
      "mark": {
        "type": "rule",
        "strokeWidth": 1.3,
        "opacity": 0.5,
        "color": "#618EA9"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "lon2"
        },
        "latitude2": {
          "field": "lat2"
        },
        "tooltip": [
          {
            "field": "distance_km",
            "title": "Straight-line distance (km)"
          },
          {
            "field": "year",
            "title": "Year"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/cleaned/flow_map_sample.csv",
        "format": {
          "type": "csv",
          "parse": {
            "lat": "number",
            "lon": "number",
            "lat2": "number",
            "lon2": "number",
            "distance_km": "number",
            "year": "number"
          }
        }
      },
      "mark": {
        "type": "circle",
        "size": 34,
        "opacity": 0.9
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "color": {
          "datum": "Where the koala was found",
          "type": "nominal",
          "scale": {
            "domain": [
              "Where the koala was found",
              "Where it was released"
            ],
            "range": [
              "#2a777e",
              "#d87545"
            ]
          },
          "legend": {
            "title": null,
            "orient": "bottom",
            "direction": "vertical",
            "symbolType": "circle"
          }
        }
      }
    },
    {
      "data": {
        "url": "data/cleaned/flow_map_sample.csv",
        "format": {
          "type": "csv",
          "parse": {
            "lat": "number",
            "lon": "number",
            "lat2": "number",
            "lon2": "number",
            "distance_km": "number",
            "year": "number"
          }
        }
      },
      "mark": {
        "type": "point",
        "shape": "triangle-up",
        "filled": true,
        "size": 38,
        "opacity": 0.95
      },
      "encoding": {
        "longitude": {
          "field": "lon2",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat2",
          "type": "quantitative"
        },
        "color": {
          "datum": "Where it was released",
          "type": "nominal",
          "scale": {
            "domain": [
              "Where the koala was found",
              "Where it was released"
            ],
            "range": [
              "#2a777e",
              "#d87545"
            ]
          }
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 10.5,
        "fontWeight": 600,
        "color": "white",
        "dy": -8,
        "stroke": "white",
        "strokeWidth": 3.5
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "n"
        }
      },
      "data": {
        "values": [
          {
            "n": "Brisbane",
            "lon": 153.03,
            "lat": -27.47
          },
          {
            "n": "Gold Coast",
            "lon": 153.4,
            "lat": -28.02
          },
          {
            "n": "Toowoomba",
            "lon": 151.95,
            "lat": -27.56
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 10.5,
        "fontWeight": 600,
        "color": "#1e3028",
        "dy": -8
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "n"
        }
      },
      "data": {
        "values": [
          {
            "n": "Brisbane",
            "lon": 153.03,
            "lat": -27.47
          },
          {
            "n": "Gold Coast",
            "lon": 153.4,
            "lat": -28.02
          },
          {
            "n": "Toowoomba",
            "lon": 151.95,
            "lat": -27.56
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 11,
        "fontWeight": 700,
        "color": "white",
        "lineBreak": "\n",
        "lineHeight": 13,
        "stroke": "white",
        "strokeWidth": 3.5
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        }
      },
      "data": {
        "values": [
          {
            "lon": 150.05,
            "lat": -24.75,
            "t": "Lines join where a koala was\nfound to where it was released"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 11,
        "fontWeight": 700,
        "color": "#8050A4",
        "lineBreak": "\n",
        "lineHeight": 13
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        }
      },
      "data": {
        "values": [
          {
            "lon": 150.05,
            "lat": -24.75,
            "t": "Lines join where a koala was\nfound to where it was released"
          }
        ]
      }
    }
  ]
}
