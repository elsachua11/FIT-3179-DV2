          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "records",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "zero": true,
            "range": [
              40,
              3000
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "titleLimit": 330,
            "labelLimit": 120,
            "title": "Koalas admitted, 1997–2024",
            "format": ",.0f",
            "values": [
              500,
              2500,
              10000
            ],
            "symbolFillColor": "#1769AA",
            "symbolOpacity": 0.7
          }
        },
        "order": {
          "field": "records",
          "type": "quantitative",
          "sort": "descending"
        },
        "color": {
          "value": "#1769AA"
        },
        "opacity": {
          "condition": {
            "param": "hover",
            "empty": false,
            "value": 0.95
          },
          "value": 0.6
        },
        "tooltip": [
          {
            "field": "lga",
            "title": "Local government area"
          },
          {
            "field": "records",
            "title": "Koalas admitted",
            "format": ",.0f"
          }
        ]
