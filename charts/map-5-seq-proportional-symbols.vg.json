    {
      "data": {
        "url": "data/cleaned/seq_basemap.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#eef2ea",
        "stroke": "#b9c6bc",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/cleaned/lga_summary.csv",
        "format": {
          "type": "csv",
          "parse": {
            "lon": "number",
            "lat": "number",
            "records": "number"
          }
        }
      },
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "on": "mouseover",
            "clear": "mouseout",
            "fields": [
              "lga"
            ]
          }
        }
      ],
      "mark": {
        "type": "circle",
        "stroke": "white",
        "strokeWidth": 1.2
      },
