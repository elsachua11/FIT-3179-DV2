{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "font": "DM Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "labelColor": "#44554b",
      "titleColor": "#44554b",
      "gridColor": "#edf1ed",
      "domainColor": "#9aa89f",
      "tickColor": "#9aa89f"
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 11,
      "labelColor": "#44554b",
      "titleColor": "#44554b"
    }
  },
  "width": "container",
  "height": 450,
  "projection": {
    "type": "mercator"
  },
  "params": [
    {
      "name": "Period",
      "value": "2016-2024",
      "bind": {
        "input": "radio",
        "options": [
          "1997-2005",
          "2006-2015",
          "2016-2024"
        ],
        "name": "Time period: "
      }
    }
  ],
  "layer": [
    {
      "data": {
        "url": "data/cleaned/seq_basemap.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#eef2ea",
        "stroke": "#b9c6bc",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/cleaned/bin_map_by_period.csv",
        "format": {
          "type": "csv",
          "parse": {
            "lon0": "number",
            "lat0": "number",
            "lon1": "number",
            "lat1": "number",
            "records": "number",
            "records_per_year": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.period == Period"
        },
        {
          "calculate": "(datum.lon0+datum.lon1)/2",
          "as": "cell_lon"
        },
        {
          "filter": "datum.cell_lon >= 150.0"
        }
      ],
      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 0.6
      },
      "encoding": {
        "longitude": {
          "field": "lon0",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat0",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "lon1"
        },
        "latitude2": {
          "field": "lat1"
        },
        "color": {
          "field": "records_per_year",
          "type": "quantitative",
          "scale": {
            "type": "threshold",
            "domain": [
              5,
              15,
              40,
              90,
              180
            ],
            "range": [
              "#FFF2D7",
              "#FED9A2",
              "#FDBB78",
              "#F27A45",
              "#CF392D",
              "#850C24"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "titleLimit": 330,
            "labelLimit": 120,
            "title": "Koalas admitted per year, per cell",
            "type": "symbol",
            "symbolType": "square"
          }
        },
        "tooltip": [
          {
            "field": "period",
            "title": "Period"
          },
          {
            "field": "records",
            "title": "Admissions in period",
            "format": ",.0f"
          },
          {
            "field": "records_per_year",
            "title": "Admissions per year"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 10.5,
        "fontWeight": 600,
        "color": "white",
        "dy": -8,
        "stroke": "white",
        "strokeWidth": 3.5
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "n"
        }
      },
      "data": {
        "values": [
          {
