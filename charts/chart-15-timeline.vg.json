{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Durations of documented habitat loss and fires, with specific policy/funding/science milestones across years. Duration is only used where the source lists an actual multiyear period.",
  "width": "container",
  "height": 350,
  "data": {
    "url": "data/cleaned/conservation_timeline.csv"
  },
  "transform": [
    {
      "calculate": "datum.start_year < datum.end_year ? 'Extended period' : 'Dated milestone'",
      "as": "timing"
    },
    {
      "calculate": "datum.start_year === datum.end_year ? datum.start_year + 0.25 : datum.end_year",
      "as": "end_display"
    },
    {
      "calculate": "datum.type === 'Threat' || datum.type === 'Habitat' ? 'Pressure' : 'Response or monitoring'",
      "as": "theme"
    }
  ],
  "encoding": {
    "y": {
      "field": "label",
      "type": "nominal",
      "sort": {
        "field": "start_year",
        "order": "ascending"
      },
      "axis": {
        "title": null,
        "labelLimit": 230,
        "labelFontSize": 11,
        "labelPadding": 9
      }
    },
    "x": {
      "field": "start_year",
      "type": "quantitative",
      "scale": {
        "domain": [
          1999,
          2027
        ]
      },
      "axis": {
        "title": "Calendar year",
        "values": [
          2000,
          2005,
          2010,
          2015,
          2020,
          2025
        ],
        "format": "d"
      }
    }
  },
  "layer": [
    {
      "transform": [
        {
          "filter": "datum.timing === 'Extended period'"
        }
      ],
      "mark": {
        "type": "bar",
        "height": 15,
        "cornerRadius": 5
      },
      "encoding": {
        "x2": {
          "field": "end_display"
        },
        "color": {
          "field": "theme",
          "type": "nominal",
          "scale": {
            "domain": [
              "Pressure",
              "Response or monitoring"
            ],
            "range": [
              "#D86A32",
              "#1769AA"
            ]
          },
          "legend": {
            "orient": "bottom",
            "title": null
          }
        },
        "tooltip": [
          {
            "field": "label",
            "title": "Period"
          },
          {
            "field": "start_year",
            "title": "From",
            "format": "d"
          },
          {
            "field": "end_year",
            "title": "Until",
            "format": "d"
          },
          {
            "field": "detail",
            "title": "Explanation"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.timing === 'Dated milestone'"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 150,
        "stroke": "white",
        "strokeWidth": 1.5
      },
      "encoding": {
        "color": {
          "field": "theme",
          "type": "nominal",
          "scale": {
            "domain": [
              "Pressure",
              "Response or monitoring"
            ],
            "range": [
              "#D86A32",
              "#1769AA"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "label",
            "title": "Milestone"
          },
          {
            "field": "start_year",
            "title": "Year",
            "format": "d"
          },
          {
            "field": "detail",
            "title": "Explanation"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "gridColor": "#E9F1F7",
      "domain": false
    }
  }
}