{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "font": "DM Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "labelColor": "#44554b",
      "titleColor": "#44554b",
      "gridColor": "#edf1ed",
      "domainColor": "#9aa89f",
      "tickColor": "#9aa89f"
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 11,
      "labelColor": "#44554b",
      "titleColor": "#44554b"
    }
  },
  "width": "container",
  "height": 330,
  "data": {
    "url": "data/cleaned/koala_population_estimates.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "low": "number",
        "high": "number",
        "point": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.series == 'Listed (QLD, NSW, ACT)'"
    },
    {
      "calculate": "datum.year - 0.3",
      "as": "x0"
    },
    {
      "calculate": "datum.year + 0.3",
      "as": "x1"
    },
    {
      "calculate": "datum.point ? format(datum.point, ',.0f') : format(datum.low, ',.0f') + '–' + format(datum.high, ',.0f')",
      "as": "label"
    },
    {
      "calculate": "datum.year == 2025 ? 'New survey data and model' : 'Earlier estimates'",
      "as": "kind"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rect",
        "cornerRadius": 3
      },
      "encoding": {
        "x": {
          "field": "x0",
          "type": "quantitative",
          "scale": {
            "domain": [
              2020.4,
              2026.2
            ]
          },
          "axis": {
            "title": "Year of estimate",
            "values": [
              2021,
              2022,
              2024,
              2025
            ],
            "format": "d",
            "grid": false
          }
        },
        "x2": {
          "field": "x1"
        },
        "y": {
          "field": "low",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              680000
            ]
          },
          "axis": {
            "title": "Estimated wild koalas (QLD + NSW + ACT)",
            "labelExpr": "datum.value == 0 ? '0' : datum.value / 1000 + 'k'",
            "tickCount": 7
          }
        },
        "y2": {
          "field": "high"
        },
        "color": {
          "field": "kind",
          "type": "nominal",
          "scale": {
            "domain": [
              "Earlier estimates",
              "New survey data and model"
            ],
            "range": [
              "#60A5D4",
              "#D86A32"
            ]
          },
          "legend": {
            "title": null,
            "orient": "top-left"
          }
        },
        "tooltip": [
          {
            "field": "year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "label",
            "title": "Estimate (koalas)"
          },
          {
            "field": "note",
            "title": "Note"
          },
          {
            "field": "source",
            "title": "Source"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.point"
        }
      ],
      "mark": {
        "type": "tick",
        "orient": "horizontal",
        "size": 48,
        "thickness": 5,
        "color": "#317AB0"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative"
        },
        "y": {
          "field": "point",
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": -9,
        "fontSize": 11.5,
        "fontWeight": 600,
        "color": "#1e3028"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative"
        },
        "y": {
          "field": "high",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 2024.5
          }
        ]
      },
      "mark": {
        "type": "rule",
        "strokeDash": [
          4,
          4
        ],
        "color": "#5f6f66"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        }
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 11.5,
        "color": "#D86A32",
        "lineBreak": "\n",
        "lineHeight": 14,
        "fontWeight": 600
      },
      "encoding": {
        "x": {
          "value": 120
        },
        "y": {
          "value": 120
        },
        "text": {
          "value": "The 2025 jump mostly reflects\nmore surveys and a new model,\nnot a proven rise in koalas."
        }
      }
    }
  ]
}