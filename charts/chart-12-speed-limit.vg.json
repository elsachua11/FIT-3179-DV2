{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "font": "DM Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "labelColor": "#44554b",
      "titleColor": "#44554b",
      "gridColor": "#edf1ed",
      "domainColor": "#9aa89f",
      "tickColor": "#9aa89f"
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 11,
      "labelColor": "#44554b",
      "titleColor": "#44554b"
    }
  },
  "width": "container",
  "height": 300,
  "data": {
    "url": "data/cleaned/vehicle_hits_by_speed_limit.csv",
    "format": {
      "type": "csv",
      "parse": {
        "speed_limit_kmh": "number",
        "records": "number"
      }
    }
  },
  "encoding": {
    "x": {
      "field": "speed_limit_kmh",
      "type": "ordinal",
      "axis": {
        "title": "Posted speed limit where the koala was hit (km/h)",
        "labelAngle": 0
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 3
      },
      "encoding": {
        "y": {
          "field": "records",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              2900
            ]
          },
          "axis": {
            "title": "Koalas hit by vehicles",
            "format": ",.0f"
          }
        },
        "color": {
          "field": "speed_band",
          "type": "nominal",
          "title": "Posted speed limit",
          "scale": {
            "domain": [
              "Below 80 km/h",
              "80 km/h and above"
            ],
            "range": [
              "#60A5D4",
              "#D86A32"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "title": null,
            "labelLimit": 210,
            "symbolType": "square"
          }
        },
        "tooltip": [
          {
            "field": "speed_limit_kmh",
            "title": "Speed limit (km/h)"
          },
          {
            "field": "records",
            "title": "Koalas",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": -7,
        "fontSize": 11,
        "fontWeight": 600,
        "color": "#1e3028"
      },
      "encoding": {
        "y": {
          "field": "records",
          "type": "quantitative"
        },
        "text": {
          "field": "records",
          "type": "quantitative",
          "format": ",.0f"
        }
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 11.5,
        "color": "#1e3028",
        "lineBreak": "\n",
        "lineHeight": 14
      },
      "encoding": {
        "x": {
          "value": 8
        },
        "y": {
          "value": 6
        },
        "text": {
          "value": "Roads signed 80 km/h or faster (orange)\naccount for 55% of strikes with a known\nlimit. Not adjusted for how much road\nexists at each speed."
        }
      }
    }
  ],
  "transform": [
    {
      "calculate": "datum.speed_limit_kmh >= 80 ? '80 km/h and above' : 'Below 80 km/h'",
      "as": "speed_band"
    }
  ]
}
