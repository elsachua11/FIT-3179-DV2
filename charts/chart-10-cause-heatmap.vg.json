{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "font": "DM Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "labelColor": "#44554b",
      "titleColor": "#44554b",
      "gridColor": "#edf1ed",
      "domainColor": "#9aa89f",
      "tickColor": "#9aa89f"
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 11,
      "labelColor": "#44554b",
      "titleColor": "#44554b"
    }
  },
  "width": "container",
  "height": 300,
  "data": {
    "url": "data/cleaned/cause_by_year.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "records": "number",
        "share_pct": "number",
        "rank": "number"
      }
    }
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "axis": {
        "title": null,
        "labelAngle": 0,
        "values": [
          1998,
          2002,
          2006,
          2010,
          2014,
          2018,
          2022
        ],
        "ticks": false,
        "domain": false
      }
    },
    "y": {
      "field": "cause",
      "type": "nominal",
      "sort": [
        "Sick",
        "Injured",
        "Vehicle hit",
        "Dead on arrival/found dead",
        "Dog attack",
        "Orphaned"
      ],
      "axis": {
        "title": null,
        "ticks": false,
        "domain": false,
        "labelLimit": 150
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "color": {
          "field": "share_pct",
          "type": "quantitative",
          "scale": {
            "scheme": "blues",
            "domain": [
              0,
              55
            ]
          },
          "legend": {
            "title": "Share of the year's admissions (%)",
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 220
          }
        },
        "tooltip": [
          {
            "field": "year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "cause",
            "title": "Recorded cause"
          },
          {
            "field": "share_pct",
            "title": "Share of admissions (%)"
          },
          {
            "field": "records",
            "title": "Koalas"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.share_pct > 22 && (datum.year % 4 == 2 || datum.year == 2024)"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 10,
        "color": "white"
      },
      "encoding": {
        "text": {
          "field": "share_pct",
          "type": "quantitative",
          "format": ".0f"
        }
      }
    }
  ]
}