{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "font": "DM Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "labelColor": "#44554b",
      "titleColor": "#44554b",
      "gridColor": "#edf1ed",
      "domainColor": "#9aa89f",
      "tickColor": "#9aa89f"
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 11,
      "labelColor": "#44554b",
      "titleColor": "#44554b"
    }
  },
  "width": "container",
  "height": 360,
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "data/cleaned/australia_states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 1.2
      },
      "encoding": {
        "fill": {
          "field": "properties.koala_status",
          "type": "nominal",
          "scale": {
            "domain": [
              "Listed endangered (2022)",
              "Not nationally listed",
              "No wild koalas (natural range)"
            ],
            "range": [
              "#D86A32",
              "#60A5D4",
              "#e6ebe4"
            ]
          },
          "legend": {
            "title": null,
            "orient": "bottom",
            "direction": "vertical",
            "symbolType": "square",
            "labelLimit": 520,
            "labelFontSize": 12,
            "labelExpr": "datum.value == 'Listed endangered (2022)' ? 'Endangered since 2022 (QLD, NSW, ACT): 398,000\u2013569,000 koalas in 2025' : datum.value == 'Not nationally listed' ? 'Not nationally listed (VIC, SA): 303,000\u2013381,000 koalas in 2025' : 'No wild koalas in their natural range'"
          }
        },
        "tooltip": [
          {
            "field": "properties.state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "properties.koala_status",
            "type": "nominal",
            "title": "Koala status"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "t": "QLD",
            "lon": 144.5,
            "lat": -22.8
          },
          {
            "t": "NSW ",
            "lon": 146.3,
            "lat": -32.2
          },
          {
            "t": "VIC",
            "lon": 144.5,
            "lat": -36.9
          },
          {
            "t": "SA",
            "lon": 135,
            "lat": -30.5
          },
          {
            "t": "WA",
            "lon": 122,
            "lat": -26
          },
          {
            "t": "NT",
            "lon": 133.3,
            "lat": -19.8
          },
          {
            "t": "TAS",
            "lon": 146.6,
            "lat": -42.1
          },
          {
            "t": "ACT",
            "lon": 149.1,
            "lat": -35.6
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 700,
        "color": "#1e3028"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        }
      }
    }
  ]
}
